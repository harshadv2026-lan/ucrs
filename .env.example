# =============================================================================
# UCRS — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# =============================================================================

# ── Oracle Database ──────────────────────────────────────────────────────────
ORACLE_USER=your_oracle_username
ORACLE_PASS=your_oracle_password
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1

# ── Admin Credentials (stored server-side only) ──────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Spring Profile ───────────────────────────────────────────────────────────
# Use "demo" for H2 in-memory mode (no Oracle needed)
# Use "oracle" (after renaming application-oracle.properties) for live Oracle
SPRING_PROFILES_ACTIVE=demo

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080
